# Financial Data Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8002

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://financial_user:financial_pass@localhost:5432/financial_db
TEST_DATABASE_URL=postgresql+asyncpg://financial_user:financial_pass@localhost:5432/financial_test_db

# User Service Client
USER_SERVICE_BASE_URL=http://localhost:8001
SERVICE_NAME=financial-data-service
SERVICE_CLIENT_ID=financial-data-service
SERVICE_CLIENT_SECRET=change-me-in-production

# MinIO / S3 Receipt Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=receipts
S3_REGION=us-east-1

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
