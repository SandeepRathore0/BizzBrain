# ==============================================================================
# BizBrain User Service - Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=false
APP_NAME=bizbrain-user-service
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16)
# Runtime database connection (restricted role: bizbrain_app, no UPDATE/DELETE on audit_log)
DATABASE_URL=postgresql+asyncpg://bizbrain_app:app_runtime_secure_pass_123@localhost:5432/user_db
# Migration database connection (table owner role: bizbrain_migrator, used only by Alembic)
MIGRATION_DATABASE_URL=postgresql+asyncpg://bizbrain_migrator:migrator_secure_pass_123@localhost:5432/user_db

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# RS256 JWT Configuration
# Required in production/staging. In development/test, transient key is auto-generated if blank.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=bizbrain-user-key-1
JWT_ISSUER=bizbrain-user-service
JWT_AUDIENCE=bizbrain-services
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14
SERVICE_TOKEN_EXPIRE_MINUTES=5
EMAIL_TOKEN_EXPIRE_HOURS=24

# Security and Throttling
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
ALLOW_EMPLOYEE_BUSINESS_CREATION=false

# Internal Client Credentials for /internal/v1/service-token (JSON map of client_id -> client_secret)
INTERNAL_SERVICE_CLIENTS={"invoice-service":"secret-invoice-key-123","financial-service":"secret-financial-key-123","payment-service":"secret-payment-key-123"}
