ENVIRONMENT=development
LOG_LEVEL=INFO

# Database URLs (Least-Privilege: runtime vs migrator)
DATABASE_URL=postgresql+asyncpg://payment_app:app_runtime_secure_pass_123@localhost:5432/payment_db
MIGRATION_DATABASE_URL=postgresql+asyncpg://payment_migrator:migrator_secure_pass_123@localhost:5432/payment_db
TEST_DATABASE_URL=postgresql+asyncpg://payment_app:app_runtime_secure_pass_123@localhost:5432/payment_test_db
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://payment_migrator:migrator_secure_pass_123@localhost:5432/payment_test_db

# PayPal Settings (Strictly sandbox only)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder
PAYPAL_WEBHOOK_ID=sandbox_webhook_id_placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# User Service Settings
USER_SERVICE_BASE_URL=http://localhost:8001
USER_SERVICE_JWKS_URL=http://localhost:8001/.well-known/jwks.json
USER_SERVICE_CLIENT_ID=payment-service
USER_SERVICE_CLIENT_SECRET=payment_service_secret_placeholder

# Invoice Service Settings
INVOICE_SERVICE_BASE_URL=http://localhost:8002

# Outbox Worker Settings
OUTBOX_POLL_INTERVAL_WORK=2.0
OUTBOX_POLL_INTERVAL_IDLE=5.0
OUTBOX_BATCH_SIZE=20
OUTBOX_VISIBILITY_TIMEOUT_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CIRCUIT_BREAKER_FAILURES=5
OUTBOX_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# Reconciliation Worker Settings
RECON_INTERVAL_SECONDS=60.0
RECON_BATCH_SIZE=50
RECON_MIN_AGE_SECONDS=120
RECON_NO_CAPTURE_WINDOW_SECONDS=900
RECON_CAPTURE_PENDING_ALERT_SECONDS=1800
RECON_ALLOCATION_STUCK_SECONDS=900
RECON_REVIEW_STUCK_SECONDS=3600
RECON_DEAD_OUTBOX_ALERT_INTERVAL_SECONDS=3600
