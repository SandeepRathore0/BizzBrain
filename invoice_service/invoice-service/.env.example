# Environment: development, test, production
ENVIRONMENT=development
SERVICE_NAME=invoice-service
DEBUG=true

# Database URLs
# Runtime URL (uses restricted invoice_app role)
DATABASE_URL=postgresql+asyncpg://invoice_app:invoice_app_pass@localhost:5432/invoice_db

# Migration URL (uses table owner / migration role invoice_owner)
MIGRATION_DATABASE_URL=postgresql+psycopg://invoice_owner:invoice_owner_pass@localhost:5432/invoice_db

# Inter-service URLs
USER_SERVICE_URL=http://localhost:8001
FINANCIAL_DATA_SERVICE_URL=http://localhost:8002

# Service client credentials
SERVICE_CLIENT_ID=invoice-service
SERVICE_CLIENT_SECRET=replace-with-secure-service-secret

# JWT verification settings
JWT_ISSUER=bizbrain-user-service
JWT_AUDIENCE=bizbrain-api
INTERNAL_JWT_AUDIENCE=invoice-service
JWKS_CACHE_TTL_SECONDS=3600
